.goals-page {
  width: min(1040px, calc(100% - 32px));
  margin: 0 auto;
  padding: 40px 0 64px;
}

.goals-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 28px;
}

.goals-eyebrow {
  margin: 0 0 8px;
  color: var(--primary-dark);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.1em;
}

.goals-header h1 {
  margin: 0;
  color: var(--text-primary);
  font-size: clamp(1.8rem, 4vw, 2.5rem);
  letter-spacing: -0.04em;
}

.goals-header > div > p:last-child {
  margin: 8px 0 0;
  color: var(--text-secondary);
}

.primary-action,
.goal-form-actions button {
  min-height: 38px;
  padding: 0 14px;
  border: 0;
  border-radius: 7px;
  background: var(--primary);
  color: #fff;
  cursor: pointer;
  font: inherit;
  font-size: 0.88rem;
  font-weight: 650;
}

.primary-action:hover,
.goal-form-actions button:hover:not(:disabled) {
  background: var(--primary-dark);
}

.goal-create-panel {
  margin-bottom: 24px;
  padding: 18px;
  border: 1px solid var(--border);
  border-left: 3px solid var(--primary);
  background: var(--surface);
}

.goal-form,
.entry-form {
  display: grid;
  gap: 12px;
}

.goal-form label,
.entry-form label {
  display: grid;
  gap: 6px;
  color: var(--text-primary);
  font-size: 0.84rem;
  font-weight: 600;
}

.goal-form label span,
.entry-form label span {
  color: var(--text-secondary);
  font-weight: 400;
}

.goal-form input,
.goal-form textarea,
.goal-form select,
.entry-form input {
  width: 100%;
  min-height: 38px;
  padding: 8px 10px;
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--text-primary);
  font: inherit;
  font-size: 0.9rem;
}
.goal-field-help {
  color: var(--text-secondary);
  font-size: 0.76rem;
  font-weight: 400;
  line-height: 1.45;
}

.goal-form textarea {
  resize: vertical;
}

.goal-form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.goal-form-extra {
  display: grid;
  gap: 12px;
  margin: 0;
  padding: 12px;
  border: 1px solid var(--border);
}

.goal-form-extra legend {
  padding: 0 5px;
  color: var(--text-secondary);
  font-size: 0.82rem;
}

.goal-weekdays {
  display: grid;
  gap: 8px;
  color: var(--text-secondary);
  font-size: 0.82rem;
}

.goal-weekdays > div {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.goal-weekdays label {
  display: flex;
  align-items: center;
  gap: 5px;
  font-weight: 400;
}

.goal-weekdays input {
  width: 15px;
  min-height: 15px;
  accent-color: var(--primary);
}

.goal-form-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 2px;
}

.goal-form-actions button:disabled {
  cursor: wait;
  opacity: 0.65;
}

.quiet-button {
  padding: 0 10px !important;
  border: 1px solid var(--border) !important;
  background: transparent !important;
  color: var(--text-secondary) !important;
}

.goals-error {
  margin: 0 0 16px;
  padding: 10px 12px;
  border-left: 3px solid var(--error);
  background: color-mix(in srgb, var(--error) 7%, var(--surface));
  color: var(--error);
  font-size: 0.9rem;
}

.goals-list {
  border-top: 1px solid var(--border);
}

.goals-empty {
  padding: 22px 0;
  color: var(--text-secondary);
}

.goals-empty h2 {
  margin: 0 0 6px;
  color: var(--text-primary);
  font-size: 1.05rem;
}

.goals-empty p {
  margin: 0 0 12px;
}

.goal-node {
  margin-left: calc(min(var(--goal-depth), 5) * 12px);
  padding: 14px 0 14px 14px;
  border-bottom: 1px solid var(--border);
  border-left: 1px solid var(--border);
}

.goal-node-title-wrap,
.goal-node-heading {
  display: flex;
  align-items: center;
  gap: 10px;
}

.goal-node-heading {
  justify-content: space-between;
}

.goal-node-title-wrap {
  min-width: 0;
}

.goal-node-title-wrap > div {
  min-width: 0;
}

.goal-node-title-wrap h3 {
  overflow-wrap: anywhere;
  margin: 0;
  color: var(--text-primary);
  font-size: 0.96rem;
  font-weight: 620;
}

.goal-node-title-wrap h3.goal-done {
  color: var(--text-secondary);
}

.goal-node-description {
  margin: 4px 0 0;
  color: var(--text-secondary);
  font-size: 0.82rem;
  line-height: 1.45;
}

.expand-button {
  flex: 0 0 24px;
  width: 24px;
  height: 24px;
  border: 0;
  background: transparent;
  color: var(--text-secondary);
  cursor: pointer;
  font-size: 1.1rem;
}

.milestone-check {
  flex: 0 0 16px;
  width: 16px;
  height: 16px;
  margin: 0;
  accent-color: var(--primary);
}

.goal-type-dot {
  flex: 0 0 9px;
  width: 9px;
  height: 9px;
  border-radius: 50%;
}

.dot-milestones {
  background: #8b83b5;
}

.dot-habit {
  background: #6f9b83;
}

.dot-target {
  background: #6e91aa;
}

.goal-type {
  flex: 0 0 auto;
  padding: 3px 7px;
  font-size: 0.7rem;
  font-weight: 650;
}

.goal-type-milestones {
  background: #f0eef7;
  color: #655c91;
}

.goal-type-habit {
  background: #eaf2ed;
  color: #4f795f;
}

.goal-type-target {
  background: #eaf0f4;
  color: #4f7088;
}

.goal-node-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 16px;
  margin: 8px 0 0 34px;
  color: var(--text-secondary);
  font-size: 0.78rem;
}

.goal-target-track {
  height: 4px;
  margin: 9px 0 0 34px;
  background: var(--surface-secondary);
}

.goal-target-track span {
  display: block;
  height: 100%;
  background: #6e91aa;
}

.goal-node-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 14px;
  margin: 7px 0 0 34px;
}

.text-button {
  padding: 3px 0;
  border: 0;
  background: transparent;
  color: var(--primary-dark);
  cursor: pointer;
  font: inherit;
  font-size: 0.78rem;
}

.text-button:hover {
  text-decoration: underline;
}

.text-button:disabled {
  cursor: wait;
  opacity: 0.55;
}

.delete-text {
  color: var(--text-secondary);
}

.delete-text:hover {
  color: var(--error);
}

.goal-history {
  margin: 12px 0 0 34px;
  color: var(--text-secondary);
  font-size: 0.8rem;
}

.goal-history summary {
  cursor: pointer;
}

.goal-history ul {
  display: grid;
  gap: 8px;
  margin: 10px 0 0;
  padding: 0;
  list-style: none;
}

.goal-entry {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 8px 0;
  border-top: 1px solid var(--border);
}

.goal-entry strong,
.goal-entry span {
  margin-right: 8px;
}

.goal-entry p {
  margin: 4px 0 0;
}

.goal-entry-actions {
  display: flex;
  gap: 10px;
}

.entry-form {
  margin: 12px 0 0 34px;
  padding: 12px;
  border-left: 2px solid #6f9b83;
  background: var(--surface-secondary);
}

.goal-children {
  margin-top: 8px;
}

@media (max-width: 640px) {
  .goals-page {
    width: min(100% - 24px, 560px);
    padding: 28px 0 48px;
  }

  .goals-header {
    align-items: flex-start;
    flex-direction: column;
    gap: 14px;
  }

  .goal-form-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .goal-node {
    margin-left: calc(min(var(--goal-depth), 3) * 6px);
    padding-left: 9px;
  }

  .goal-node-heading {
    align-items: flex-start;
  }

  .goal-history,
  .entry-form,
  .goal-node-actions,
  .goal-node-summary,
  .goal-target-track {
    margin-left: 28px;
  }
}